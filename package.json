{
  "name": "kinetix-studio",
  "productName": "Kinetix Studio",
  "version": "1.0.0",
  "description": "Native cross-platform desktop video editing studio with an open local REST API for external AI agents.",
  "author": {
    "name": "Kinetix Labs",
    "email": "labs@kinetix.studio"
  },
  "homepage": "https://github.com/kinetix-labs/kinetix-studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/kinetix-labs/kinetix-studio.git"
  },
  "bugs": {
    "url": "https://github.com/kinetix-labs/kinetix-studio/issues"
  },
  "license": "MIT",
  "main": "dist-main/main.js",
  "scripts": {
    "dev": "npm run build:main && concurrently -k \"vite\" \"cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run typecheck && npm run build:main && npm run build:renderer",
    "build:win": "npm run build && node scripts/stage-ffmpeg.mjs && electron-builder --win",
    "build:mac": "npm run build && node scripts/stage-ffmpeg.mjs && electron-builder --mac",
    "build:linux": "npm run build && node scripts/stage-ffmpeg.mjs && node scripts/build-linux.mjs",
    "start": "electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "fluent-ffmpeg": "^2.1.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "zustand": "^5.0.2"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0"
  },
  "build": {
    "appId": "com.kinetix.studio",
    "productName": "Kinetix Studio",
    "copyright": "Copyright © 2026 Kinetix Labs",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-main/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "src/main/python",
        "to": "python",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "extraResources": [
        {
          "from": "vendor/ffmpeg/win32",
          "to": "ffmpeg",
          "filter": ["**/*"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Kinetix Studio"
    },
    "mac": {
      "category": "public.app-category.video",
      "target": [
        { "target": "dmg", "arch": ["universal"] },
        { "target": "zip", "arch": ["universal"] }
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extraResources": [
        {
          "from": "vendor/ffmpeg/darwin",
          "to": "ffmpeg",
          "filter": ["**/*"]
        }
      ]
    },
    "dmg": {
      "title": "Kinetix Studio"
    },
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ],
      "category": "AudioVideo",
      "synopsis": "Desktop video editing studio with open local API",
      "extraResources": [
        {
          "from": "vendor/ffmpeg/linux",
          "to": "ffmpeg",
          "filter": ["**/*"]
        }
      ]
    }
  }
}
